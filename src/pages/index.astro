---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const featuredArticles = [
	{
		title: 'キャラグリ初心者は何から始めればいい？',
		description: '初めてキャラグリに行く人向けに、準備・当日の動き方・不安の減らし方をまとめます。',
		href: '/blog/character-greeting-beginner/',
		tag: '初心者向け',
	},
	{
		title: '一人でテーマパークに行くのは変？',
		description: '一人だからこそ推しキャラ目的で動きやすい理由と、気楽に楽しむ考え方を整理します。',
		href: '/blog/solo-theme-park/',
		tag: '一人参加',
	},
	{
		title: 'キャラグリに必要な持ち物リスト',
		description: 'スマホ・モバイルバッテリー・推しグッズなど、荷物を増やしすぎない準備を紹介します。',
		href: '/blog/character-greeting-items/',
		tag: '持ち物',
	},
	{
		title: 'キャラグリで何を話せばいい？',
		description: 'キャラクターが返しやすい会話ネタ、避けたい話題、写真前の声かけをまとめます。',
		href: '/blog/character-greeting-talk/',
		tag: '会話',
	},
	{
		title: 'キャラグリで写真を撮るコツ',
		description: 'スマホ撮影、ポーズのお願い方、ツーショット、撮影後のお礼まで実体験ベースで解説します。',
		href: '/blog/character-greeting-photo/',
		tag: '撮影',
	},
];

const siteTopics = [
	'キャラグリ初心者向けの準備',
	'テーマパーク遠征の持ち物',
	'一人テーマパークの楽しみ方',
	'写真・会話・ポーズのコツ',
];
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="site-label">キャラグリ・テーマパーク遠征の攻略ノート</p>
				<h1>
					推しキャラに会う前に、<br />
					知っておきたいこと。
				</h1>
				<p class="lead">
					推しキャラ遭遇研究所は、キャラクターグリーティングを中心に、準備・持ち物・撮影・会話・当日の動き方をまとめる小さな専門サイトです。
				</p>
				<div class="hero-actions">
					<a class="primary-button" href="/blog/">記事一覧を見る</a>
					<a class="secondary-button" href="/about/">このサイトについて</a>
				</div>
			</section>

			<section class="topics">
				<h2>このサイトで扱うこと</h2>
				<ul class="topic-list">
					{siteTopics.map((topic) => <li>{topic}</li>)}
				</ul>
			</section>

			<section class="featured">
				<div class="section-heading">
					<h2>まず読んでほしい記事</h2>
					<p>
						初めてキャラグリに行く人や、一人でテーマパークに行くのが少し不安な人向けに、最初に読みやすい記事をまとめました。
					</p>
				</div>

				<div class="article-grid">
					{featuredArticles.map((article) => (
						<a class="article-card" href={article.href}>
							<span class="tag">{article.tag}</span>
							<h3>{article.title}</h3>
							<p>{article.description}</p>
							<span class="read-more">この記事を読む</span>
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(body) {
		font-family:
			-apple-system,
			BlinkMacSystemFont,
			'Hiragino Sans',
			'Hiragino Kaku Gothic ProN',
			'Yu Gothic',
			'YuGothic',
			'Meiryo',
			sans-serif;
		background: #fafafa;
		color: #151821;
	}

	main {
		width: min(960px, calc(100% - 2rem));
		margin: 0 auto;
		padding: 3.5rem 0 5rem;
	}

	.hero {
		padding: 2.5rem 0 2rem;
	}

	.site-label {
		margin: 0 0 0.9rem;
		color: #51607a;
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.7;
	}

	h1 {
		max-width: 960px;
		margin: 0;
		font-size: clamp(2rem, 4vw, 2.8rem);
		line-height: 1.35;
		letter-spacing: -0.03em;
		font-weight: 800;
	}

	.lead {
		max-width: 720px;
		margin: 1.4rem 0 0;
		color: #374151;
		font-size: 1.08rem;
		line-height: 2;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-top: 2rem;
	}

	.primary-button,
	.secondary-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.8rem 1.15rem;
		border-radius: 999px;
		font-weight: 700;
		text-decoration: none;
		line-height: 1;
	}

	.primary-button {
		background: #1f2937;
		color: #fff;
	}

	.secondary-button {
		border: 1px solid #d9dee8;
		color: #1f2937;
		background: #fff;
	}

	.primary-button:hover,
	.secondary-button:hover {
		opacity: 0.86;
	}

	.topics,
	.featured {
		margin-top: 3.5rem;
	}

	h2 {
		margin: 0 0 1rem;
		font-size: clamp(1.7rem, 4vw, 2.4rem);
		line-height: 1.35;
		letter-spacing: -0.02em;
	}

	.section-heading {
		max-width: 720px;
		margin-bottom: 1.6rem;
	}

	.section-heading p {
		margin: 0;
		color: #4b5563;
		font-size: 1rem;
		line-height: 1.9;
	}

	.topic-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.8rem;
		padding: 0;
		margin: 0;
		list-style: none;
		max-width: 760px;
	}

	.topic-list li {
		padding: 1rem 1.1rem;
		border: 1px solid #d9dee8;
		border-radius: 0.9rem;
		background: #fff;
		color: #283142;
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.6;
		box-shadow: 0 6px 16px rgba(15, 23, 42, 0.035);
	}

	.article-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.article-card {
		display: flex;
		flex-direction: column;
		min-height: 190px;
		padding: 1.25rem;
		border: 1px solid #d9dee8;
		border-radius: 1rem;
		background: #fff;
		color: inherit;
		text-decoration: none;
		box-shadow: 0 8px 22px rgba(15, 23, 42, 0.05);
		transition:
			transform 140ms ease,
			box-shadow 140ms ease,
			border-color 140ms ease;
	}

	.article-card:hover {
		transform: translateY(-2px);
		border-color: #9aa8bd;
		box-shadow: 0 12px 28px rgba(15, 23, 42, 0.09);
	}

	.tag {
		width: fit-content;
		padding: 0.25rem 0.6rem;
		border-radius: 999px;
		background: #eef2f7;
		color: #45556c;
		font-size: 0.78rem;
		font-weight: 700;
		line-height: 1.4;
	}

	.article-card h3 {
		margin: 0.85rem 0 0.45rem;
		font-size: 1.22rem;
		line-height: 1.55;
		letter-spacing: -0.01em;
	}

	.article-card p {
		margin: 0;
		color: #4b5563;
		font-size: 0.98rem;
		line-height: 1.85;
	}

	.read-more {
		margin-top: auto;
		padding-top: 1rem;
		color: #1f2937;
		font-weight: 700;
	}

	@media (max-width: 760px) {
		main {
			width: min(100% - 1.25rem, 960px);
			padding-top: 2rem;
		}

		.hero {
			padding-top: 1.5rem;
		}

		h1 {
			font-size: 2rem;
			line-height: 1.4;
		}

		.topic-list {
			grid-template-columns: 1fr;
		}

		.article-grid {
			grid-template-columns: 1fr;
		}

		.article-card {
			min-height: auto;
		}
	}
</style>