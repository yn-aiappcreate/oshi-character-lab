---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const topics = [
	{
		title: 'キャラグリ初心者向けの準備',
		description: '初めてキャラクターに会いに行く前に、知っておきたい基本を整理します。',
	},
	{
		title: 'テーマパーク遠征の持ち物',
		description: 'スマホ・モバイルバッテリー・推しグッズなど、身軽に動くための準備をまとめます。',
	},
	{
		title: '一人テーマパークの楽しみ方',
		description: '一人だからこそ推しキャラ目的で動きやすい理由と、不安を減らす考え方を紹介します。',
	},
	{
		title: '写真・会話・ポーズのコツ',
		description: '撮影のお願い方、キャラクターへの声かけ、自然に楽しむためのコツをまとめます。',
	},
];

const readers = [
	'初めてキャラグリに行く',
	'一人でテーマパークに行くのが不安',
	'推しキャラに会う前に準備しておきたい',
	'写真や会話で失敗したくない',
];

const featuredArticles = [
	{
		title: 'キャラグリ初心者は何から始めればいい？',
		description: '初めてキャラグリに行く人向けに、準備・当日の動き方・不安の減らし方をまとめます。',
		href: '/blog/character-greeting-beginner/',
		tag: '初心者向け',
	},
	{
		title: '一人でテーマパークに行くのは変？',
		description: '一人だからこそ推しキャラ目的で動きやすい理由と、気楽に楽しむ考え方を整理します。',
		href: '/blog/solo-theme-park/',
		tag: '一人参加',
	},
	{
		title: 'キャラグリに必要な持ち物リスト',
		description: 'スマホ・モバイルバッテリー・推しグッズなど、荷物を増やしすぎない準備を紹介します。',
		href: '/blog/character-greeting-items/',
		tag: '持ち物',
	},
	{
		title: 'キャラグリで何を話せばいい？',
		description: 'キャラクターが返しやすい会話ネタ、避けたい話題、写真前の声かけをまとめます。',
		href: '/blog/character-greeting-talk/',
		tag: '会話',
	},
	{
		title: 'キャラグリで写真を撮るコツ',
		description: 'スマホ撮影、ポーズのお願い方、ツーショット、撮影後のお礼まで実体験ベースで解説します。',
		href: '/blog/character-greeting-photo/',
		tag: '撮影',
	},
];
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main>
			<section class="hero">
				<div class="section-inner hero-inner">
					<p class="site-label">キャラグリ・テーマパーク遠征の攻略ノート</p>

					<h1 class="hero-title">
						<span class="hero-line">推しキャラに会う前に、</span>
						<span class="hero-line">知っておきたいこと。</span>
					</h1>

					<p class="lead">
						キャラクターグリーティングを中心に、準備・持ち物・撮影・会話・当日の動き方をまとめる小さな専門サイトです。
					</p>

					<div class="hero-actions">
						<a class="primary-button" href="/blog/">記事一覧を見る</a>
						<a class="secondary-button" href="/about/">このサイトについて</a>
					</div>
				</div>
			</section>

			<section class="for-readers">
				<div class="section-inner">
					<div class="soft-panel">
						<div class="panel-copy">
							<p class="section-kicker">For beginners</p>
							<h2>こんな人向けのサイトです</h2>
						</div>

						<ul class="reader-list">
							{readers.map((reader) => <li>{reader}</li>)}
						</ul>
					</div>
				</div>
			</section>

			<section class="topics">
				<div class="section-inner">
					<div class="section-heading">
						<p class="section-kicker">Guide themes</p>
						<h2>このサイトで扱うこと</h2>
					</div>

					<div class="topic-grid">
						{topics.map((topic, index) => (
							<article class="topic-card">
								<span class="topic-icon">{index + 1}</span>
								<h3>{topic.title}</h3>
								<p>{topic.description}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="featured">
				<div class="section-inner">
					<div class="section-heading">
						<p class="section-kicker">Start here</p>
						<h2>まず読んでほしい記事</h2>
						<p>
							初めてキャラグリに行く人や、一人でテーマパークに行くのが少し不安な人向けに、最初に読みやすい記事をまとめました。
						</p>
					</div>

					<div class="article-grid">
						{featuredArticles.map((article) => (
							<a class="article-card" href={article.href}>
								<span class="tag">{article.tag}</span>
								<h3>{article.title}</h3>
								<p>{article.description}</p>
								<span class="read-more">この記事を読む →</span>
							</a>
						))}
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		font-family:
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			'Hiragino Sans',
			'Noto Sans JP',
			'Yu Gothic',
			'YuGothic',
			'Meiryo',
			sans-serif;
		color: #2f2933;
		background: #fffafc;
		line-height: 1.8;
	}

	main {
		width: 100%;
		max-width: none !important;
		margin: 0 !important;
		padding: 0 !important;
	}

	section {
		padding: 72px 24px;
	}

	.section-inner {
		max-width: 1120px;
		margin: 0 auto;
	}

	.hero {
		padding-top: 84px;
		padding-bottom: 56px;
		background:
			radial-gradient(circle at 20% 0%, rgba(255, 224, 236, 0.5), transparent 32%),
			linear-gradient(180deg, #fff7fb 0%, #ffffff 74%);
	}

	.hero-inner {
		max-width: 960px;
		text-align: center;
	}

	.site-label,
	.section-kicker {
		margin: 0 0 12px;
		color: #8b6b7d;
		font-size: 0.92rem;
		font-weight: 700;
		letter-spacing: 0.04em;
	}

	.hero-title {
		margin: 0;
		color: #11131a;
		font-size: clamp(44px, 6vw, 76px);
		font-weight: 800;
		line-height: 1.12;
		letter-spacing: 0.01em;
	}

	.hero-line {
		display: block;
		white-space: nowrap;
	}

	.lead {
		max-width: 640px;
		margin: 24px auto 0;
		color: #5f5a66;
		font-size: 1.06rem;
		line-height: 1.95;
	}

	.hero-actions {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 32px;
	}

	.primary-button,
	.secondary-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 14px 22px;
		border-radius: 999px;
		font-weight: 700;
		text-decoration: none;
		transition:
			transform 140ms ease,
			box-shadow 140ms ease,
			background 140ms ease,
			border-color 140ms ease;
	}

	.primary-button {
		background: #2f2433;
		color: #fff;
		box-shadow: 0 10px 24px rgba(47, 36, 51, 0.12);
	}

	.secondary-button {
		border: 1px solid #e7dce5;
		background: #fff;
		color: #2f2433;
	}

	.primary-button:hover,
	.secondary-button:hover {
		transform: translateY(-1px);
	}

	.for-readers {
		padding-top: 32px;
		padding-bottom: 56px;
		background: #fff;
	}

	.soft-panel {
		display: grid;
		gap: 28px;
		padding: 36px;
		border: 1px solid #f0e6ed;
		border-radius: 28px;
		background: #fff8fb;
	}

	.panel-copy {
		text-align: center;
	}

	.panel-copy h2 {
		margin: 0;
		color: #11131a;
		font-size: clamp(28px, 3.2vw, 40px);
		line-height: 1.35;
		letter-spacing: 0.02em;
	}

	.reader-list {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 14px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.reader-list li {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 82px;
		padding: 18px 18px 18px 42px;
		border: 1px solid #f4eaf0;
		border-radius: 18px;
		background: #ffffff;
		color: #4d4652;
		font-size: 0.96rem;
		font-weight: 700;
		line-height: 1.65;
	}

	.reader-list li::before {
		content: '';
		position: absolute;
		left: 18px;
		top: 50%;
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: #e3abc3;
		transform: translateY(-50%);
	}

	.section-heading {
		max-width: 680px;
		margin-bottom: 36px;
	}

	.section-heading h2 {
		margin: 0;
		color: #11131a;
		font-size: clamp(30px, 4vw, 46px);
		line-height: 1.25;
		letter-spacing: 0.02em;
	}

	.section-heading p {
		max-width: 640px;
		margin: 16px 0 0;
		color: #625b66;
		font-size: 1rem;
		line-height: 1.9;
	}

	.topics {
		background: #fffafc;
	}

	.topic-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px;
	}

	.topic-card {
		min-height: 210px;
		padding: 24px;
		border: 1px solid #f0e6ed;
		border-radius: 20px;
		background: #ffffff;
		box-shadow: 0 8px 24px rgba(47, 36, 51, 0.04);
	}

	.topic-icon {
		display: inline-flex;
		width: 34px;
		height: 34px;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		background: #fff0f6;
		color: #8d5f76;
		font-size: 0.9rem;
		font-weight: 800;
	}

	.topic-card h3 {
		margin: 18px 0 8px;
		color: #2f2933;
		font-size: 1.22rem;
		line-height: 1.5;
	}

	.topic-card p {
		margin: 0;
		color: #625b66;
		font-size: 0.96rem;
		line-height: 1.85;
	}

	.featured {
		background: #fff;
	}

	.article-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
	}

	.article-card {
		display: flex;
		flex-direction: column;
		min-height: 280px;
		padding: 24px;
		border: 1px solid #eee4eb;
		border-radius: 24px;
		background: #fff;
		color: inherit;
		text-decoration: none;
		box-shadow: 0 8px 24px rgba(47, 36, 51, 0.035);
		transition:
			transform 140ms ease,
			box-shadow 140ms ease,
			border-color 140ms ease;
	}

	.article-card:hover {
		transform: translateY(-2px);
		border-color: #e0ccd8;
		box-shadow: 0 14px 32px rgba(47, 36, 51, 0.08);
	}

	.tag {
		width: fit-content;
		padding: 5px 10px;
		border-radius: 999px;
		background: #f7edf3;
		color: #7d5a6d;
		font-size: 0.78rem;
		font-weight: 800;
		line-height: 1.4;
	}

	.article-card h3 {
		margin: 16px 0 10px;
		color: #2f2933;
		font-size: 20px;
		line-height: 1.55;
		letter-spacing: 0.01em;
	}

	.article-card p {
		margin: 0;
		color: #625b66;
		font-size: 14px;
		line-height: 1.85;
	}

	.read-more {
		margin-top: auto;
		padding-top: 20px;
		color: #2f2433;
		font-size: 0.95rem;
		font-weight: 800;
	}

	@media (max-width: 1024px) {
		.article-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.reader-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 720px) {
		section {
			padding: 56px 18px;
		}

		.hero {
			padding-top: 64px;
			padding-bottom: 40px;
		}

		.hero-inner {
			text-align: left;
		}

		.hero-title {
			font-size: clamp(36px, 11vw, 48px);
			line-height: 1.18;
		}

		.hero-line {
			white-space: normal;
		}

		.lead {
			margin-left: 0;
			margin-right: 0;
			font-size: 1rem;
		}

		.hero-actions {
			justify-content: flex-start;
		}

		.soft-panel {
			padding: 24px;
			border-radius: 22px;
		}

		.panel-copy {
			text-align: left;
		}

		.reader-list,
		.topic-grid,
		.article-grid {
			grid-template-columns: 1fr;
		}

		.reader-list li {
			min-height: auto;
		}

		.topic-card,
		.article-card {
			min-height: auto;
		}
	}
</style>