---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const topics = [
	{
		title: '遠征準備',
		description: '初めてキャラクターに会いに行く前に、知っておきたい準備を整理します。',
		icon: 'ticket',
	},
	{
		title: '持ち物データ',
		description: 'スマホ・モバイルバッテリー・推しグッズなど、身軽に動くための持ち物をまとめます。',
		icon: 'bag',
	},
	{
		title: '一人テーマパーク調査',
		description: '一人だからこそ推しキャラ目的で動きやすい理由と、不安を減らす考え方を紹介します。',
		icon: 'map',
	},
	{
		title: '撮影・会話ログ',
		description: '写真のお願い方、キャラクターへの声かけ、ポーズ指定のコツをまとめます。',
		icon: 'camera',
	},
];

const readers = [
	'初めてキャラグリに行く',
	'一人でテーマパークに行くのが不安',
	'推しキャラに会う前に準備しておきたい',
	'写真や会話で失敗したくない',
];

const featuredArticles = [
	{
		title: 'キャラグリ初心者は何から始めればいい？',
		description: '初めてキャラグリに行く人向けに、準備・当日の動き方・不安の減らし方をまとめます。',
		href: '/blog/character-greeting-beginner/',
		tag: '初心者向け調査ノート',
		featured: true,
	},
	{
		title: '一人でテーマパークに行くのは変？',
		description: '一人だからこそ推しキャラ目的で動きやすい理由と、気楽に楽しむ考え方を整理します。',
		href: '/blog/solo-theme-park/',
		tag: '一人遠征',
	},
	{
		title: 'キャラグリに必要な持ち物リスト',
		description: 'スマホ・モバイルバッテリー・推しグッズなど、荷物を増やしすぎない準備を紹介します。',
		href: '/blog/character-greeting-items/',
		tag: '持ち物データ',
	},
	{
		title: 'キャラグリで何を話せばいい？',
		description: 'キャラクターが返しやすい会話ネタ、避けたい話題、写真前の声かけをまとめます。',
		href: '/blog/character-greeting-talk/',
		tag: '会話メモ',
	},
	{
		title: 'キャラグリで写真を撮るコツ',
		description: 'スマホ撮影、ポーズのお願い方、ツーショット、撮影後のお礼まで実体験ベースで解説します。',
		href: '/blog/character-greeting-photo/',
		tag: '撮影ログ',
	},
];

const [featureArticle, ...regularArticles] = featuredArticles;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main>
			<section class="hero">
				<div class="section-inner hero-grid">
					<div class="hero-copy">
						<p class="site-label">キャラグリ・テーマパーク遠征の攻略ノート</p>

						<h1 class="hero-title">
							<span class="hero-line">推しキャラに会う前に、</span>
							<span class="hero-line">知っておきたいこと。</span>
						</h1>

						<p class="lead">
							キャラクターグリーティングを中心に、準備・持ち物・撮影・会話・当日の動き方をまとめる小さな専門メディアです。
						</p>

						<p class="human-copy">
							推しが目の前に来た瞬間、話したいことが全部飛ぶ。だからこそ、少しだけ準備しておくと安心です。
						</p>

						<div class="hero-actions">
							<a class="primary-button" href="/blog/">観測メモを読む</a>
							<a class="secondary-button" href="/about/">研究所について</a>
						</div>
					</div>

					<div class="hero-visual" aria-hidden="true">
						<div class="map-line map-line-one"></div>
						<div class="map-line map-line-two"></div>
						<div class="star star-one"></div>
						<div class="star star-two"></div>
						<div class="dot-grid"></div>

						<div class="expedition-card ticket-card">
							<span class="mini-label">TICKET</span>
							<span class="ticket-title">遠征パス</span>
							<span class="ticket-line"></span>
						</div>

						<div class="expedition-card camera-card">
							<span class="icon-shape camera-shape"></span>
							<span>撮影ログ</span>
						</div>

						<div class="expedition-card memo-card">
							<span class="mini-label">OBSERVATION</span>
							<span>観測メモ</span>
							<ul>
								<li>持ち物</li>
								<li>会話</li>
								<li>ポーズ</li>
							</ul>
						</div>

						<div class="expedition-card bag-card">
							<span class="icon-shape bag-shape"></span>
							<span>推し活遠征セット</span>
						</div>
					</div>
				</div>
			</section>

			<section class="for-readers">
				<div class="section-inner">
					<div class="soft-panel">
						<div class="panel-copy">
							<p class="section-kicker">For beginners</p>
							<h2>こんな人向けのサイトです</h2>
						</div>

						<ul class="reader-list">
							{readers.map((reader) => <li>{reader}</li>)}
						</ul>
					</div>
				</div>
			</section>

			<section class="topics">
				<div class="section-inner">
					<div class="section-heading">
						<p class="section-kicker">Research themes</p>
						<h2>この研究所で扱うテーマ</h2>
						<p>
							キャラグリ初心者が迷いやすい準備・持ち物・一人参加・撮影や会話を、実体験ベースの攻略メモとして整理しています。
						</p>
					</div>

					<div class="topic-grid">
						{topics.map((topic) => (
							<article class="topic-card">
								<span class={`topic-icon ${topic.icon}`} aria-hidden="true"></span>
								<h3>{topic.title}</h3>
								<p>{topic.description}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="featured">
				<div class="section-inner">
					<div class="section-heading">
						<p class="section-kicker">Observation logs</p>
						<h2>まず読んでほしい観測メモ</h2>
						<p>
							初めてキャラグリに行く人や、一人でテーマパークに行くのが少し不安な人向けに、最初に読みやすい記事をまとめました。
						</p>
					</div>

					<div class="article-layout">
						<a class="article-card feature-card" href={featureArticle.href}>
							<span class="tag">{featureArticle.tag}</span>
							<h3>{featureArticle.title}</h3>
							<p>{featureArticle.description}</p>
							<span class="read-more">この記事を読む →</span>
						</a>

						<div class="regular-grid">
							{regularArticles.map((article) => (
								<a class="article-card" href={article.href}>
									<span class="tag">{article.tag}</span>
									<h3>{article.title}</h3>
									<p>{article.description}</p>
									<span class="read-more">この記事を読む →</span>
								</a>
							))}
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		font-family:
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			'Hiragino Sans',
			'Noto Sans JP',
			'Yu Gothic',
			'YuGothic',
			'Meiryo',
			sans-serif;
		color: #2f2933;
		background: #fffafc;
		line-height: 1.8;
	}

	main {
		width: 100%;
		max-width: none !important;
		margin: 0 !important;
		padding: 0 !important;
		overflow: hidden;
	}

	section {
		padding: 84px 24px;
	}

	.section-inner {
		max-width: 1120px;
		margin: 0 auto;
	}

	.hero {
		position: relative;
		padding-top: 112px;
		padding-bottom: 96px;
		background:
			radial-gradient(circle at 14% 12%, rgba(255, 224, 236, 0.7), transparent 30%),
			radial-gradient(circle at 88% 18%, rgba(238, 243, 248, 0.9), transparent 26%),
			linear-gradient(180deg, #fff7fb 0%, #fffdf8 78%);
	}

	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0.45;
		background-image:
			linear-gradient(90deg, rgba(124, 77, 102, 0.08) 1px, transparent 1px),
			linear-gradient(rgba(124, 77, 102, 0.08) 1px, transparent 1px);
		background-size: 44px 44px;
		mask-image: linear-gradient(180deg, black 0%, transparent 80%);
	}

	.hero-grid {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
		gap: 56px;
		align-items: center;
	}

	.site-label,
	.section-kicker {
		margin: 0 0 12px;
		color: #7c4d66;
		font-size: 0.92rem;
		font-weight: 800;
		letter-spacing: 0.04em;
	}

	.hero-title {
		margin: 0;
		color: #11131a;
		font-size: clamp(42px, 5.4vw, 72px);
		font-weight: 850;
		line-height: 1.13;
		letter-spacing: 0.01em;
	}

	.hero-line {
		display: block;
		white-space: nowrap;
	}

	.lead {
		max-width: 640px;
		margin: 24px 0 0;
		color: #5f5a66;
		font-size: 1.08rem;
		line-height: 1.95;
	}

	.human-copy {
		max-width: 620px;
		margin: 18px 0 0;
		padding-left: 16px;
		border-left: 3px solid #e6c3d3;
		color: #6f6673;
		font-size: 0.98rem;
		line-height: 1.9;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 34px;
	}

	.primary-button,
	.secondary-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 14px 22px;
		border-radius: 999px;
		font-weight: 800;
		text-decoration: none;
		transition:
			transform 140ms ease,
			box-shadow 140ms ease,
			background 140ms ease,
			border-color 140ms ease;
	}

	.primary-button {
		background: #2f2433;
		color: #fff;
		box-shadow: 0 12px 28px rgba(47, 36, 51, 0.14);
	}

	.secondary-button {
		border: 1px solid #e7dce5;
		background: rgba(255, 255, 255, 0.82);
		color: #2f2433;
	}

	.primary-button:hover,
	.secondary-button:hover {
		transform: translateY(-1px);
	}

	.hero-visual {
		position: relative;
		min-height: 430px;
		border: 1px solid #eee4eb;
		border-radius: 36px;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.78), rgba(248, 237, 243, 0.78)),
			#fff;
		box-shadow: 0 24px 60px rgba(47, 36, 51, 0.09);
		overflow: hidden;
	}

	.map-line {
		position: absolute;
		border: 1px dashed rgba(124, 77, 102, 0.22);
		border-color: rgba(124, 77, 102, 0.22) transparent transparent transparent;
		border-radius: 50%;
	}

	.map-line-one {
		width: 340px;
		height: 180px;
		left: -70px;
		top: 92px;
		transform: rotate(-12deg);
	}

	.map-line-two {
		width: 380px;
		height: 220px;
		right: -120px;
		bottom: 30px;
		transform: rotate(16deg);
	}

	.star {
		position: absolute;
		width: 14px;
		height: 14px;
		background: #d9a5bc;
		clip-path: polygon(50% 0%, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0% 50%, 38% 38%);
		opacity: 0.5;
	}

	.star-one {
		top: 42px;
		right: 64px;
	}

	.star-two {
		left: 62px;
		bottom: 54px;
		transform: scale(0.8);
	}

	.dot-grid {
		position: absolute;
		inset: 32px;
		opacity: 0.18;
		background-image: radial-gradient(#7c4d66 1px, transparent 1px);
		background-size: 18px 18px;
	}

	.expedition-card {
		position: absolute;
		display: grid;
		gap: 8px;
		padding: 18px;
		border: 1px solid rgba(238, 228, 235, 0.95);
		border-radius: 22px;
		background: rgba(255, 255, 255, 0.86);
		box-shadow: 0 12px 30px rgba(47, 36, 51, 0.08);
		backdrop-filter: blur(10px);
		color: #2f2933;
		font-weight: 800;
	}

	.ticket-card {
		left: 40px;
		top: 42px;
		width: 190px;
		transform: rotate(-4deg);
	}

	.camera-card {
		right: 44px;
		top: 72px;
		width: 150px;
	}

	.memo-card {
		left: 92px;
		bottom: 52px;
		width: 210px;
	}

	.bag-card {
		right: 52px;
		bottom: 78px;
		width: 170px;
		transform: rotate(3deg);
	}

	.mini-label {
		color: #8b6b7d;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
	}

	.ticket-title {
		font-size: 1.25rem;
	}

	.ticket-line {
		display: block;
		width: 100%;
		height: 8px;
		border-radius: 999px;
		background: repeating-linear-gradient(
			90deg,
			#f8edf3 0,
			#f8edf3 12px,
			#eef3f8 12px,
			#eef3f8 24px
		);
	}

	.icon-shape {
		display: block;
		width: 42px;
		height: 34px;
		border: 2px solid #d9a5bc;
		border-radius: 12px;
		background: #fff8fb;
	}

	.camera-shape::before {
		content: '';
		display: block;
		width: 13px;
		height: 13px;
		margin: 9px auto 0;
		border: 2px solid #7c4d66;
		border-radius: 999px;
	}

	.bag-shape {
		position: relative;
		border-radius: 12px 12px 14px 14px;
	}

	.bag-shape::before {
		content: '';
		position: absolute;
		left: 10px;
		top: -10px;
		width: 18px;
		height: 14px;
		border: 2px solid #d9a5bc;
		border-bottom: 0;
		border-radius: 12px 12px 0 0;
	}

	.memo-card ul {
		display: grid;
		gap: 4px;
		margin: 0;
		padding: 0;
		list-style: none;
		color: #6f6673;
		font-size: 0.9rem;
		font-weight: 700;
	}

	.memo-card li::before {
		content: '✓';
		margin-right: 6px;
		color: #7c4d66;
	}

	.for-readers {
		padding-top: 44px;
		padding-bottom: 72px;
		background: #fff;
	}

	.soft-panel {
		display: grid;
		gap: 28px;
		padding: 36px;
		border: 1px solid #f0e6ed;
		border-radius: 28px;
		background: #fff8fb;
	}

	.panel-copy {
		text-align: center;
	}

	.panel-copy h2 {
		margin: 0;
		color: #11131a;
		font-size: clamp(28px, 3.2vw, 40px);
		line-height: 1.35;
		letter-spacing: 0.02em;
	}

	.reader-list {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 14px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.reader-list li {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 82px;
		padding: 18px 18px 18px 42px;
		border: 1px solid #f4eaf0;
		border-radius: 18px;
		background: #ffffff;
		color: #4d4652;
		font-size: 0.96rem;
		font-weight: 700;
		line-height: 1.65;
	}

	.reader-list li::before {
		content: '';
		position: absolute;
		left: 18px;
		top: 50%;
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: #e3abc3;
		transform: translateY(-50%);
	}

	.section-heading {
		max-width: 700px;
		margin-bottom: 40px;
	}

	.section-heading h2 {
		margin: 0;
		color: #11131a;
		font-size: clamp(30px, 4vw, 46px);
		line-height: 1.25;
		letter-spacing: 0.02em;
	}

	.section-heading p {
		max-width: 640px;
		margin: 16px 0 0;
		color: #625b66;
		font-size: 1rem;
		line-height: 1.9;
	}

	.topics {
		background: #fffafc;
	}

	.topic-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 22px;
	}

	.topic-card {
		min-height: 220px;
		padding: 28px;
		border: 1px solid #f0e6ed;
		border-radius: 22px;
		background: #ffffff;
		box-shadow: 0 8px 24px rgba(47, 36, 51, 0.04);
	}

	.topic-icon {
		position: relative;
		display: inline-flex;
		width: 42px;
		height: 42px;
		border: 1px solid #e7dce5;
		border-radius: 14px;
		background: #f8edf3;
	}

	.topic-icon::before,
	.topic-icon::after {
		content: '';
		position: absolute;
		border-color: #7c4d66;
	}

	.topic-icon.ticket::before {
		left: 10px;
		top: 12px;
		width: 20px;
		height: 14px;
		border: 2px solid #7c4d66;
		border-radius: 5px;
	}

	.topic-icon.bag::before {
		left: 10px;
		top: 16px;
		width: 20px;
		height: 15px;
		border: 2px solid #7c4d66;
		border-radius: 4px;
	}

	.topic-icon.bag::after {
		left: 14px;
		top: 10px;
		width: 12px;
		height: 9px;
		border: 2px solid #7c4d66;
		border-bottom: 0;
		border-radius: 8px 8px 0 0;
	}

	.topic-icon.map::before {
		left: 10px;
		top: 10px;
		width: 20px;
		height: 22px;
		border: 2px solid #7c4d66;
		border-radius: 5px;
		transform: rotate(-4deg);
	}

	.topic-icon.camera::before {
		left: 9px;
		top: 13px;
		width: 22px;
		height: 16px;
		border: 2px solid #7c4d66;
		border-radius: 6px;
	}

	.topic-icon.camera::after {
		left: 17px;
		top: 18px;
		width: 6px;
		height: 6px;
		border: 2px solid #7c4d66;
		border-radius: 999px;
	}

	.topic-card h3 {
		margin: 18px 0 8px;
		color: #2f2933;
		font-size: 1.24rem;
		line-height: 1.5;
	}

	.topic-card p {
		margin: 0;
		color: #625b66;
		font-size: 0.96rem;
		line-height: 1.85;
	}

	.featured {
		background: #fff;
	}

	.article-layout {
		display: grid;
		grid-template-columns: minmax(300px, 1.05fr) minmax(0, 1.45fr);
		gap: 24px;
		align-items: stretch;
	}

	.regular-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px;
	}

	.article-card {
		display: flex;
		flex-direction: column;
		min-height: 260px;
		padding: 24px;
		border: 1px solid #eee4eb;
		border-radius: 24px;
		background: #fff;
		color: inherit;
		text-decoration: none;
		box-shadow: 0 8px 24px rgba(47, 36, 51, 0.035);
		transition:
			transform 140ms ease,
			box-shadow 140ms ease,
			border-color 140ms ease;
	}

	.feature-card {
		min-height: 100%;
		padding: 32px;
		background:
			radial-gradient(circle at 100% 0%, rgba(238, 243, 248, 0.9), transparent 34%),
			#fff8fb;
	}

	.article-card:hover {
		transform: translateY(-2px);
		border-color: #e0ccd8;
		box-shadow: 0 14px 32px rgba(47, 36, 51, 0.08);
	}

	.tag {
		width: fit-content;
		padding: 5px 10px;
		border-radius: 999px;
		background: #f7edf3;
		color: #7d5a6d;
		font-size: 0.78rem;
		font-weight: 800;
		line-height: 1.4;
	}

	.article-card h3 {
		margin: 16px 0 10px;
		color: #2f2933;
		font-size: 20px;
		line-height: 1.55;
		letter-spacing: 0.01em;
	}

	.feature-card h3 {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		line-height: 1.35;
	}

	.article-card p {
		margin: 0;
