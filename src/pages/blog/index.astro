---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const getPostTag = (title: string) => {
	if (title.includes('初心者')) return '初心者向け';
	if (title.includes('一人')) return '一人参加';
	if (title.includes('持ち物')) return '持ち物';
	if (title.includes('話')) return '会話';
	if (title.includes('写真')) return '撮影';
	return '攻略記事';
};
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`記事一覧 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<section class="blog-hero">
				<div class="section-inner">
					<p class="page-kicker">攻略記事一覧</p>
					<h1>
						<span>キャラグリ・遠征準備の</span>
						<span>攻略記事</span>
					</h1>
					<p class="lead">
						キャラクターグリーティング、テーマパーク遠征、一人参加、持ち物、撮影、会話のコツをまとめています。
					</p>
				</div>
			</section>

			<section class="post-section">
				<div class="section-inner">
					<div class="section-heading">
						<h2>記事一覧</h2>
						<p>初めて読む人は、初心者向けの記事から順番に読むのがおすすめです。</p>
					</div>

					<div class="post-grid">
						{
							posts.map((post) => (
								<a class="post-card" href={`/blog/${post.id}/`}>
									<div class="post-card-top">
										<span class="tag">{getPostTag(post.data.title)}</span>
										<span class="date">
											<FormattedDate date={post.data.pubDate} />
										</span>
									</div>

									<h3>{post.data.title}</h3>

									<p>{post.data.description}</p>

									<span class="read-more">この記事を読む →</span>
								</a>
							))
						}
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		font-family:
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			'Hiragino Sans',
			'Noto Sans JP',
			'Yu Gothic',
			'YuGothic',
			'Meiryo',
			sans-serif;
		color: #2f2933;
		background: #fffafc;
		line-height: 1.8;
	}

	main {
		width: 100%;
		max-width: none !important;
		margin: 0 !important;
		padding: 0 !important;
	}

	.section-inner {
		max-width: 1120px;
		margin: 0 auto;
	}

	.blog-hero {
		position: relative;
		padding: 88px 24px 72px;
		background:
			radial-gradient(circle at 14% 12%, rgba(255, 224, 236, 0.68), transparent 30%),
			radial-gradient(circle at 88% 18%, rgba(238, 243, 248, 0.9), transparent 28%),
			linear-gradient(180deg, #fff7fb 0%, #fffdf8 78%);
		overflow: hidden;
	}

	.blog-hero::before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0.34;
		background-image:
			linear-gradient(90deg, rgba(124, 77, 102, 0.08) 1px, transparent 1px),
			linear-gradient(rgba(124, 77, 102, 0.08) 1px, transparent 1px);
		background-size: 44px 44px;
		mask-image: linear-gradient(180deg, black 0%, transparent 82%);
	}

	.blog-hero .section-inner {
		position: relative;
		z-index: 1;
		max-width: 880px;
		text-align: center;
	}

	.page-kicker {
		margin: 0 0 12px;
		color: #7c4d66;
		font-size: 0.92rem;
		font-weight: 800;
		letter-spacing: 0.04em;
	}

	h1 {
		margin: 0;
		color: #11131a;
		font-size: clamp(2.4rem, 5vw, 4.1rem);
		font-weight: 850;
		line-height: 1.18;
		letter-spacing: 0.01em;
	}

	h1 span {
		display: block;
		white-space: nowrap;
	}

	.lead {
		max-width: 660px;
		margin: 22px auto 0;
		color: #5f5a66;
		font-size: 1.06rem;
		line-height: 1.95;
	}

	.post-section {
		padding: 72px 24px 96px;
		background: #fffafc;
	}

	.section-heading {
		max-width: 700px;
		margin-bottom: 36px;
	}

	.section-heading h2 {
		margin: 0;
		color: #11131a;
		font-size: clamp(1.9rem, 4vw, 2.8rem);
		line-height: 1.25;
		letter-spacing: 0.02em;
	}

	.section-heading p {
		max-width: 640px;
		margin: 14px 0 0;
		color: #625b66;
		font-size: 1rem;
		line-height: 1.9;
	}

	.post-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
		align-items: stretch;
	}

	.post-grid > * {
		min-width: 0;
	}

	.post-card {
		display: flex;
		flex-direction: column;
		min-height: 300px;
		padding: 24px;
		border: 1px solid #eee4eb;
		border-radius: 24px;
		background: #fff;
		color: inherit;
		text-decoration: none;
		box-shadow: 0 8px 24px rgba(47, 36, 51, 0.035);
		transition:
			transform 140ms ease,
			box-shadow 140ms ease,
			border-color 140ms ease;
	}

	.post-card:hover {
		transform: translateY(-2px);
		border-color: #e0ccd8;
		box-shadow: 0 14px 32px rgba(47, 36, 51, 0.08);
	}

	.post-card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 16px;
	}

	.tag {
		display: inline-flex;
		align-items: center;
		width: fit-content;
		padding: 5px 10px;
		border-radius: 999px;
		background: #f7edf3;
		color: #7d5a6d;
		font-size: 0.78rem;
		font-weight: 800;
		line-height: 1.4;
		white-space: nowrap;
	}

	.date {
		color: #8a8390;
		font-size: 0.82rem;
		font-weight: 700;
		white-space: nowrap;
	}

	.post-card h3 {
		margin: 0 0 10px;
		color: #2f2933;
		font-size: 20px;
		line-height: 1.55;
		letter-spacing: 0.01em;
	}

	.post-card p {
		margin: 0;
		color: #625b66;
		font-size: 14px;
		line-height: 1.85;
	}

	.read-more {
		margin-top: auto;
		padding-top: 22px;
		color: #2f2433;
		font-size: 0.95rem;
		font-weight: 800;
	}

	@media (max-width: 1040px) {
		.post-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 720px) {
		.blog-hero {
			padding: 64px 18px 56px;
		}

		.blog-hero .section-inner {
			text-align: left;
		}

		h1 {
			font-size: clamp(2.05rem, 10vw, 3rem);
			line-height: 1.22;
		}

		h1 span {
			white-space: normal;
		}

		.lead {
			margin-left: 0;
			margin-right: 0;
			font-size: 1rem;
		}

		.post-section {
			padding: 56px 18px 72px;
		}

		.post-grid {
			grid-template-columns: 1fr;
		}

		.post-card {
			min-height: auto;
		}

		.post-card-top {
			align-items: flex-start;
			flex-direction: column;
			gap: 8px;
		}
	}
</style>