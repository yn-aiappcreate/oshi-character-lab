---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />

		<main>
			<article class="article-page">
				<header class="article-header">
					<p class="article-kicker">推しキャラ遭遇研究所</p>
					<h1>{title}</h1>

					<p class="description">{description}</p>

					<div class="article-meta">
						<span>
							公開日：
							<FormattedDate date={pubDate} />
						</span>

						{
							updatedDate && (
								<span>
									更新日：
									<FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
				</header>

				{
					heroImage && (
						<div class="hero-image">
							<Image width={1120} height={560} src={heroImage} alt="" />
						</div>
					)
				}

				<div class="article-shell">
					<div class="article-note">
						<p>この記事は、キャラグリ・テーマパーク遠征を迷わず楽しむための攻略メモです。</p>
					</div>

					<div class="prose">
						<slot />
					</div>
				</div>
			</article>
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		font-family:
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			'Hiragino Sans',
			'Noto Sans JP',
			'Yu Gothic',
			'YuGothic',
			'Meiryo',
			sans-serif;
		color: #2f2933;
		background: #fffafc;
		line-height: 1.8;
	}

	main {
		width: 100%;
		max-width: none !important;
		margin: 0 !important;
		padding: 0 !important;
		background:
			radial-gradient(circle at 12% 0%, rgba(255, 224, 236, 0.55), transparent 28%),
			linear-gradient(180deg, #fff7fb 0%, #fffdf8 360px, #fffafc 100%);
	}

	.article-page {
		padding: 72px 20px 88px;
	}

	.article-header {
		max-width: 880px;
		margin: 0 auto 40px;
		text-align: center;
	}

	.article-kicker {
		margin: 0 0 12px;
		color: #7c4d66;
		font-size: 0.92rem;
		font-weight: 800;
		letter-spacing: 0.04em;
	}

	.article-header h1 {
		margin: 0;
		color: #11131a;
		font-size: clamp(2.2rem, 5vw, 4.3rem);
		font-weight: 850;
		line-height: 1.22;
		letter-spacing: 0.01em;
		text-wrap: balance;
	}

	.description {
		max-width: 680px;
		margin: 20px auto 0;
		color: #625b66;
		font-size: 1.05rem;
		line-height: 1.9;
	}

	.article-meta {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 10px 18px;
		margin-top: 24px;
		color: #8a8390;
		font-size: 0.9rem;
		font-weight: 700;
	}

	.hero-image {
		max-width: 1040px;
		margin: 0 auto 40px;
		border-radius: 28px;
		overflow: hidden;
		border: 1px solid #eee4eb;
		background: #fff;
		box-shadow: 0 20px 48px rgba(47, 36, 51, 0.08);
	}

	.hero-image img {
		display: block;
		width: 100%;
		height: auto;
	}

	.article-shell {
		display: grid;
		grid-template-columns: minmax(0, 760px);
		justify-content: center;
		max-width: 1040px;
		margin: 0 auto;
	}

	.article-note {
		margin-bottom: 24px;
		padding: 18px 20px;
		border: 1px solid #f0e6ed;
		border-radius: 20px;
		background: #fff8fb;
		color: #6f6673;
	}

	.article-note p {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.8;
	}

	.prose {
		padding: 42px;
		border: 1px solid #eee4eb;
		border-radius: 28px;
		background: #fff;
		box-shadow: 0 14px 36px rgba(47, 36, 51, 0.05);
		color: #3f3944;
		font-size: 1.06rem;
		line-height: 1.95;
	}

	.prose :global(*) {
		box-sizing: border-box;
	}

	.prose :global(p) {
		margin: 0 0 1.35em;
		color: #3f3944;
		line-height: 1.95;
	}

	.prose :global(p:last-child) {
		margin-bottom: 0;
	}

	.prose :global(h2) {
		margin: 2.4em 0 0.75em;
		padding-top: 0.2em;
		color: #11131a;
		font-size: clamp(1.55rem, 3vw, 2rem);
		line-height: 1.4;
		letter-spacing: 0.02em;
	}

	.prose :global(h2:first-child) {
		margin-top: 0;
	}

	.prose :global(h3) {
		margin: 2em 0 0.65em;
		color: #2f2933;
		font-size: 1.28rem;
		line-height: 1.5;
		letter-spacing: 0.02em;
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin: 1em 0 1.6em;
		padding-left: 1.4em;
		color: #3f3944;
	}

	.prose :global(li) {
		margin: 0.45em 0;
		line-height: 1.9;
	}

	.prose :global(a) {
		color: #7c4d66;
		font-weight: 700;
		text-underline-offset: 0.22em;
	}

	.prose :global(a:hover) {
		color: #2f2433;
	}

	.prose :global(table) {
		display: block;
		width: 100%;
		margin: 2rem 0;
		overflow-x: auto;
		border: 1px solid #eee4eb;
		border-radius: 18px;
		background: #fff;
		font-size: 0.95rem;
		line-height: 1.75;
		border-spacing: 0;
	}

	.prose :global(table thead) {
		background: #fff8fb;
	}

	.prose :global(table th),
	.prose :global(table td) {
		padding: 14px 16px;
		border-bottom: 1px solid #eee4eb;
		border-right: 1px solid #eee4eb;
		vertical-align: top;
		text-align: left;
		overflow-wrap: break-word;
		word-break: normal;
	}

	.prose :global(table th) {
		color: #2f2933;
		font-weight: 800;
		white-space: nowrap;
		background: #fff8fb;
	}

	.prose :global(table td) {
		color: #4b4450;
		background: #fff;
	}

	.prose :global(table th:last-child),
	.prose :global(table td:last-child) {
		border-right: 0;
	}

	.prose :global(table tr:last-child td) {
		border-bottom: 0;
	}

	.prose :global(table tbody tr:nth-child(even) td) {
		background: #fffdf8;
	}

	.prose :global(table tbody tr:hover td) {
		background: #fff8fb;
	}

	.prose :global(blockquote) {
		margin: 1.8em 0;
		padding: 18px 22px;
		border-left: 4px solid #d9a5bc;
		border-radius: 0 18px 18px 0;
		background: #fff8fb;
		color: #5f5663;
	}

	.prose :global(hr) {
		margin: 2.4em 0;
		border: 0;
		border-top: 1px solid #eee4eb;
	}

	.prose :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: 20px;
	}

	.prose :global(code) {
		padding: 0.15em 0.35em;
		border-radius: 6px;
		background: #f8edf3;
		color: #5f344a;
		font-size: 0.92em;
	}

	.prose :global(pre) {
		overflow-x: auto;
		padding: 18px;
		border-radius: 18px;
		background: #2f2933;
		color: #fff;
	}

	.prose :global(pre code) {
		padding: 0;
		background: transparent;
		color: inherit;
	}

	@media (max-width: 720px) {
		.article-page {
			padding: 56px 16px 72px;
		}

		.article-header {
			margin-bottom: 30px;
			text-align: left;
		}

		.article-header h1 {
			font-size: clamp(2rem, 10vw, 3rem);
			line-height: 1.25;
		}

		.description {
			margin-left: 0;
			margin-right: 0;
			font-size: 1rem;
		}

		.article-meta {
			justify-content: flex-start;
		}

		.hero-image {
			margin-bottom: 28px;
			border-radius: 22px;
		}

		.article-note {
			border-radius: 18px;
		}

		.prose {
			padding: 26px 20px;
			border-radius: 22px;
			font-size: 1rem;
			line-height: 1.9;
		}

		.prose :global(p) {
			line-height: 1.9;
		}

		.prose :global(table) {
			font-size: 0.9rem;
			white-space: nowrap;
		}

		.prose :global(table th),
		.prose :global(table td) {
			padding: 12px 14px;
		}
	}
</style>