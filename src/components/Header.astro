---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="site-title" href="/">{SITE_TITLE}</a>
		<div class="nav-links">
			<HeaderLink href="/blog">記事一覧</HeaderLink>
			<HeaderLink href="/blog/character-greeting-beginner/">はじめての方へ</HeaderLink>
			<HeaderLink href="/about">このサイトについて</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		margin: 0;
		padding: 0 24px;
		border-bottom: 1px solid #f1e8ee;
		background: rgba(255, 255, 255, 0.82);
		backdrop-filter: blur(12px);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		max-width: 1120px;
		min-height: 64px;
		margin: 0 auto;
	}

	.site-title {
		color: #2f2933;
		font-size: 1rem;
		font-weight: 800;
		text-decoration: none;
		white-space: nowrap;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.nav-links a {
		padding: 10px 12px;
		border-radius: 999px;
		color: #4b4450;
		font-size: 0.95rem;
		font-weight: 700;
		text-decoration: none;
	}

	.nav-links a:hover {
		background: #fff1f7;
		color: #2f2933;
	}

	.nav-links a.active {
		background: #2f2433;
		color: #fff;
	}

	@media (max-width: 720px) {
		header {
			padding: 0 16px;
		}

		nav {
			min-height: auto;
			padding: 12px 0;
			align-items: flex-start;
			flex-direction: column;
			gap: 8px;
		}

		.nav-links {
			width: 100%;
			overflow-x: auto;
			padding-bottom: 2px;
			white-space: nowrap;
		}

		.nav-links a {
			font-size: 0.88rem;
			padding: 8px 10px;
		}
	}
</style>